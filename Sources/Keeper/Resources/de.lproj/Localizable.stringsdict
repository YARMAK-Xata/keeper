		</dict>
		<key>sites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Website</string>
			<key>other</key>
			<string>%lld Websites</string>
		</dict>
	</dict>
</dict>
</plist>
