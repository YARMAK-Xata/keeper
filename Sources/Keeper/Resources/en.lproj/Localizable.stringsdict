<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>state.onDuty.subtitle</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@sites@</string>
		<key>sites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Guarding %lld site</string>
			<key>other</key>
			<string>Guarding %lld sites</string>
		</dict>
	</dict>
	<key>state.onDuty.subtitle.apps</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Guarding %lld app</string>
			<key>other</key>
			<string>Guarding %lld apps</string>
		</dict>
	</dict>
	<key>state.onDuty.subtitle.both</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Guarding %1$#@sites@ and %2$#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld app</string>
			<key>other</key>
			<string>%lld apps</string>
		</dict>
		<key>sites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld site</string>
			<key>other</key>
			<string>%lld sites</string>
		</dict>
	</dict>
</dict>
</plist>
