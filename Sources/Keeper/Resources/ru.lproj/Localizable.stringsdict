<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>state.onDuty.subtitle</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@sites@</string>
		<key>sites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Охраняю %lld сайта</string>
			<key>many</key>
			<string>Охраняю %lld сайтов</string>
			<key>one</key>
			<string>Охраняю %lld сайт</string>
			<key>other</key>
			<string>Охраняю %lld сайта</string>
		</dict>
	</dict>
	<key>state.onDuty.subtitle.apps</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Охраняю %lld программы</string>
			<key>many</key>
			<string>Охраняю %lld программ</string>
			<key>one</key>
			<string>Охраняю %lld программу</string>
			<key>other</key>
			<string>Охраняю %lld программы</string>
		</dict>
	</dict>
	<key>state.onDuty.subtitle.both</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Охраняю %1$#@sites@ и %2$#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld программы</string>
			<key>many</key>
			<string>%lld программ</string>
			<key>one</key>
			<string>%lld программу</string>
			<key>other</key>
			<string>%lld программы</string>
		</dict>
		<key>sites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld сайта</string>
			<key>many</key>
			<string>%lld сайтов</string>
			<key>one</key>
			<string>%lld сайт</string>
			<key>other</key>
			<string>%lld сайта</string>
		</dict>
	</dict>
</dict>
</plist>
