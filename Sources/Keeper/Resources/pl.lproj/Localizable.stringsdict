<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>state.onDuty.subtitle</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@sites@</string>
		<key>sites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Chronię %lld witryny</string>
			<key>many</key>
			<string>Chronię %lld witryn</string>
			<key>one</key>
			<string>Chronię %lld witrynę</string>
			<key>other</key>
			<string>Chronię %lld witryny</string>
		</dict>
	</dict>
	<key>state.onDuty.subtitle.apps</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Chronię %lld aplikacje</string>
			<key>many</key>
			<string>Chronię %lld aplikacji</string>
			<key>one</key>
			<string>Chronię %lld aplikację</string>
			<key>other</key>
			<string>Chronię %lld aplikacji</string>
		</dict>
	</dict>
	<key>state.onDuty.subtitle.both</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Chronię %1$#@sites@ i %2$#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld aplikacje</string>
			<key>many</key>
			<string>%lld aplikacji</string>
			<key>one</key>
			<string>%lld aplikację</string>
			<key>other</key>
			<string>%lld aplikacji</string>
		</dict>
		<key>sites</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld witryny</string>
			<key>many</key>
			<string>%lld witryn</string>
			<key>one</key>
			<string>%lld witrynę</string>
			<key>other</key>
